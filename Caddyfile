# HTTPS in front of the app. Set DOMAIN in .env to your domain and Caddy gets and renews the certificate by itself.
# With DOMAIN unset it serves plain http on port 80, which is fine for a first try by IP address.
{$DOMAIN::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# One shared login for the whole site. GATEX_USER and GATEX_PASS_HASH come from .env (make the hash with
	# `docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the password'`). If either is missing, Caddy refuses to start,
	# so the site is never left open by mistake.
	basic_auth {
		{$GATEX_USER} {$GATEX_PASS_HASH}
	}

	reverse_proxy app:4000
}
