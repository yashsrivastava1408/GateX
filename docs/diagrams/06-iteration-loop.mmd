flowchart LR
  D["<b>Author prepares</b><br/>the file and<br/>its scorecard"]
  S["<b>Add them</b><br/>file +<br/>scorecard (any layout)"]
  E(["<b>GateX</b><br/>3 Examiners mark it,<br/>a Final reviewer compares,<br/>a fixed rule picks the colour"])
  V{"Colour from<br/>the score"}
  G["<b>GREEN</b><br/>75 or more"]
  N["Done: ready to move on"]
  A["<b>AMBER</b><br/>60 to 74: fix the issues,<br/>path to green first"]
  P["<b>Peer reviewer</b><br/>checks the fixes (optional)"]
  S2["<b>Check again</b><br/>a new round with<br/>its own score"]
  R["<b>RED</b><br/>below 60: fix the issues,<br/>path to green first"]

  D --> S --> E --> V
  V -- "75 or more" --> G --> N
  V -- "60 to 74" --> A --> P --> S2 --> E
  V -- "below 60" --> R --> P

  classDef agent fill:#0f2a27,stroke:#2dd4bf,color:#ececf0,stroke-width:2px
  classDef good fill:#0f2218,stroke:#3ecf8e,color:#ececf0
  classDef warn fill:#262010,stroke:#f5b13d,color:#ececf0
  classDef bad fill:#2a1413,stroke:#f2655c,color:#ececf0
  classDef gate fill:#14141a,stroke:#7aa2f7,color:#ececf0
  class E agent
  class G,N good
  class A,P,S2 warn
  class R bad
  class V gate
