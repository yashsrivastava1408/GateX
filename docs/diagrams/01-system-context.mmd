flowchart LR
  subgraph PEOPLE["People (they add the work and fix the issues; the marking is automatic)"]
    direction TB
    AU["Author<br/><i>adds a file and a scorecard,<br/>fixes the issues, checks again</i>"]
    PR["Peer reviewer<br/><i>checks the fixes before the next check</i>"]
    ME["Mentor / Lead<br/><i>reads the reports<br/>and the score trend</i>"]
  end

  subgraph SYS["GateX"]
    direction TB
    UI["Dashboard<br/>in the browser"]
    API["API<br/>server"]
    AG(["<b>GateX engine</b><br/>Examiners 1, 2, 3<br/>+ a Final reviewer"])
    DB[("Postgres<br/>checks · scores · issues · logs")]
    FS[["Upload store<br/>read-only copies of your files"]]
  end

  subgraph MODELS["Model services (approved models only)"]
    direction TB
    GQ["Model service 1"]
    GM["Model service 2"]
    OT["Any OpenAI-style API"]
  end

  AU --> UI
  PR --> UI
  ME --> UI
  UI <-->|REST| API
  API --> AG
  API <--> DB
  API --> FS
  AG -.->|reads, never writes| FS
  AG -->|HTTPS, keys kept on the server| GQ
  AG --> GM
  AG --> OT

  classDef agent fill:#0f2a27,stroke:#2dd4bf,color:#ececf0,stroke-width:2px
  classDef store fill:#12151f,stroke:#7aa2f7,color:#ececf0
  classDef ext fill:#1b1710,stroke:#f5b13d,color:#ececf0
  class AG agent
  class DB,FS store
  class GQ,GM,OT ext
