flowchart TD
  S["Weighted score out of 100<br/>each question counts by its weight<br/>a question with no mark counts as 0<br/>nothing in the file to measure: left out (or 0 if the scorecard says so)"]
  Q1{"score below 60?"}
  RED["RED<br/>below 60"]
  Q2{"score below 75?"}
  AMB["AMBER<br/>60 to 74"]
  GRN["GREEN<br/>75 to 100"]
  N["Needs attention (listed first, colour unchanged):<br/>must-pass questions below 4, Must fix issues,<br/>marks only one Examiner backed, little of the scorecard marked"]

  S --> Q1
  Q1 -- yes --> RED
  Q1 -- no --> Q2
  Q2 -- yes --> AMB
  Q2 -- no --> GRN
  S -.-> N

  classDef good fill:#0f2218,stroke:#3ecf8e,color:#ececf0
  classDef warn fill:#262010,stroke:#f5b13d,color:#ececf0
  classDef bad fill:#2a1413,stroke:#f2655c,color:#ececf0
  classDef gate fill:#14141a,stroke:#7aa2f7,color:#ececf0
  classDef agent fill:#0f2a27,stroke:#2dd4bf,color:#ececf0
  class GRN good
  class AMB warn
  class RED bad
  class Q1,Q2 gate
  class S,N agent
