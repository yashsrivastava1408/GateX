flowchart LR
  subgraph USERS["Users"]
    B["Browser"]
  end

  subgraph HOST["One machine (laptop or VM)"]
    direction TB
    PX["Reverse proxy with SSO / auth<br/><i>recommended in front for shared use<br/>(adds sign-in and HTTPS)</i>"]
    subgraph DOCKER["docker compose up --build"]
      NODE["Node 22 app container<br/>serves API and the built dashboard<br/><i>or: npm run start on the host</i>"]
      PGC[("Postgres 16<br/>volume: ddd_pgdata")]
    end
    ENV[".env<br/>model API keys · MODELS_CONFIG"]
    UPL["data/uploads · data/reports<br/>copies and saved report files"]
  end

  subgraph NET["Model services (HTTPS)"]
    direction TB
    P1["Model service 1"]
    P2["Model service 2"]
    P4["Model service 3"]
    P3["Any OpenAI-style API"]
  end

  B --> PX --> NODE
  B -. "local development: direct" .-> NODE
  NODE --> PGC
  NODE --> UPL
  ENV -.-> NODE
  NODE --> P1
  NODE --> P2
  NODE --> P4
  NODE --> P3

  classDef agent fill:#0f2a27,stroke:#2dd4bf,color:#ececf0
  classDef store fill:#12151f,stroke:#7aa2f7,color:#ececf0
  classDef ext fill:#1b1710,stroke:#f5b13d,color:#ececf0
  class NODE agent
  class PGC,UPL,ENV store
  class P1,P2,P3,P4 ext
